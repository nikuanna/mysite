{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pip3 install --quiet yt-dlp pillow || pip install --quiet yt-dlp || echo 'yt-dlp unavailable'; python3 tools/fetch_videos.py . || echo 'video refresh skipped'; python3 tools/build.py . || echo 'build skipped, using committed pages'",
  "outputDirectory": ".",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/annanikulina/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "upgrade-insecure-requests; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
